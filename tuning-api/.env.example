# Google Cloud project (ID or number)
GCP_PROJECT=123456789012
# Region where tuning jobs are run
GCP_LOCATION=us-central
# Cloud Storage bucket for photos and datasets
GCS_BUCKET=your-backet-name
# Base model for fine-tuning
BASE_MODEL=model-name
# Default tuned model endpoint (for /recognize)
TUNED_ENDPOINT=projects/0123456789/locations/us/endpoints/1233445745160
# If set, all requests must contain the X-API-Key header with this value
API_KEY=